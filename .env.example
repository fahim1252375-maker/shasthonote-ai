# Required: server-side Gemini API key. Never expose this value in frontend code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: choose a Gemini model available to your API project.
# The default is gemini-2.5-flash; verify model availability in your Google AI Studio project.
GEMINI_MODEL="gemini-2.5-flash"

# Firebase project ID must match firebase-applet-config.json.
FIREBASE_PROJECT_ID="gen-lang-client-0324783220"

# Required for server-enforced AI consent cookies. Generate a unique secret:
# openssl rand -base64 32
AI_CONSENT_COOKIE_SECRET=""

# Optional: server port (defaults to 3000).
PORT=3000

# Optional (production only): enforce the Content-Security-Policy.
# By default the policy is sent as Content-Security-Policy-Report-Only so it can never break
# Google sign-in. Set to "true" after checking the browser console shows no violations.
CSP_ENFORCE=false
